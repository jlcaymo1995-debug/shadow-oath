{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],

    // Phase 1a: the extracted monolith is plain JS and is NOT type-checked.
    // Phase 1b carves it into .ts modules, which ARE checked under "strict".
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "vite.config.ts"]
}
